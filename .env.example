# Required — PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional — reserved cache (sessions/rate limits)
# REDIS_URL=redis://127.0.0.1:6379

# Optional — OTP SMS provider webhook (POST {to, text}); without it the OTP is
# logged on the server console (and echoed by the API in development mode)
# SMS_WEBHOOK_URL=https://your-sms-gateway.example/send

# ── Smart reading ─────────────────────────────────────────────────────
# On-device OCR (Tesseract, English + Hindi) is always on. It reads photos and
# scanned PDFs so documents are sorted by their CONTENT. No internet needed.
# OCR_DISABLED=1            # turn it off (file names only)
# OCR_LANGS=eng+hin         # add packs with: npm i @tesseract.js-data/<lang>

# Optional AI brain: any OpenAI-compatible chat endpoint. The model receives
# the OCR text + your family roster and returns type / person / title / facts.
# Leave unset → rule-based sorting only (still works well).
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
#   Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
#   Ollama (fully offline): AI_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=llama3.2  (no key)
# AI_TIMEOUT_MS=20000
